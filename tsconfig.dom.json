{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "jsx": "react-jsx",
    "paths": {
      "@maskelex/core-engine/types": [
        "./packages/core-engine/src/types/contracts.ts"
      ],
      "@maskelex/core-engine/testing": [
        "./packages/core-engine/src/testing/index.ts"
      ],
      "@maskelex/core-engine": [
        "./packages/core-engine/src/index.ts"
      ],
      "@maskelex/document-parsers": [
        "./packages/document-parsers/src/index.ts"
      ]
    }
  },
  "include": [
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "packages/core-engine/src/**/*.ts",
    "apps/desktop-tauri/src/**/*.ts"
  ]
}
