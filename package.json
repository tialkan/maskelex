{
  "name": "maskelex",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.dom.json && tsc -p tsconfig.e2e.json",
    "test:acceptance": "for f in $(ls test/t*.ts | sort -V); do tsx --tsconfig tsconfig.json \"$f\" || exit 1; done",
    "test": "pnpm test:acceptance",
    "check:copy": "node scripts/check-copy.mjs",
    "lint": "eslint .",
    "test:e2e": "pnpm --filter @maskelex/web build && tsx --tsconfig tsconfig.e2e.json e2e/security.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.13.0",
    "fflate": "^0.8.3",
    "playwright": "1.63.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "license": "AGPL-3.0-or-later"
}
